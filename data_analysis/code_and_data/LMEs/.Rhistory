#checking similarity of trial count to check if uniform
table(df$HL, df$pav)
table(df$block)
# Interaction_model - reference
model_interact <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:pav + stimulus:block +
HL:pav + HL:block + pav:block +
(1 | userId),
data = df)
interact <- summary(model_interact)
interact
### stimulus:HL:pav is 3 way interaction###
## remove stim:HL
model_nostimHL <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:pav + stimulus:block +
HL:pav + HL:block + pav:block +
(1 | userId), data = df)
## remove stim:pav
model_nostimPav <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:block +
HL:pav + HL:block + pav:block +
(1 | userId), data = df)
## remove stim:block
model_nostimBlock <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:pav +
HL:pav + HL:block + pav:block +
(1 | userId), data = df)
## remove all stim interactions - block, pav, HL
model_nostim <- lmer(rt ~ stimulus + HL + pav + block +
HL:pav + HL:block + pav:block +
(1 | userId), data = df)
## remove HL:pav
model_nohlPav <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:pav + stimulus:block +
HL:block + pav:block +
(1 | userId), data = df)
## remove HL:block
model_nohlBlock <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:pav + stimulus:block +
HL:pav + pav:block +
(1 | userId), data = df)
### remove pav:block
model_nopavBlock <- lmer(rt ~ stimulus + HL + pav + block +
stimulus:HL + stimulus:pav + stimulus:block +
HL:pav + HL:block +
(1 | userId), data = df)
# list of infos
models <- list(
full = model_interact,
No_stimHL = model_nostimHL,
No_stimPav = model_nostimPav,
No_stimBlock = model_nostimBlock,
No_HLpav = model_nohlPav,
No_HLblock = model_nohlBlock,
No_pavBlock = model_nopavBlock
)
# Extract AIC/BIC values
model_stats <- data.frame(
model = names(models),
AIC = sapply(models, AIC),
BIC = sapply(models, BIC)
)
# Long format
model_stats_long <- model_stats %>%
pivot_longer(cols = c(AIC, BIC), names_to = "Metric", values_to = "Value")
# AIC & BIC plot
plot <- ggplot(model_stats_long, aes(x = reorder(model, Value), y = Value, fill = Metric)) +
geom_col(position = 'dodge') +
geom_text(aes(label = round(Value, 1)),
position = position_dodge(width = 0.9),
vjust = -0.5, size = 3) +
labs(title = 'Accuracy Model Comparison (AIC & BIC)', x = 'Model', y = 'Value') +
theme_classic() +
coord_cartesian(ylim = c(20200, 20800)) +
scale_fill_manual(values = c('AIC' = 'blue', 'BIC' = 'red'))
plot
