df <- read.csv('/home/aswin/R/Projects/Reinforcement Learning/loseless_game-data.csv')# View(data)
library(dplyr)
library(rstatix)
library(knitr)
# Filter for PC only
df_pc <- df %>% filter(pav == "PC")
# Accuracy comparison: HTA vs LTA within each block
acc_htalta <- df_pc %>%
group_by(block) %>%
wilcox_test(accuracy ~ HL) %>%
adjust_pvalue(method = "bonferroni") %>%
add_significance("p.adj") %>%
select(block, p, p.adj, p.adj.signif)
library(dplyr)
library(rstatix)
library(knitr)
# Filter only PC trials
df_pc <- df %>% filter(pav == "PC")
# Keep only blocks with both HTA and LTA
df_pc_filtered <- df_pc %>%
group_by(block) %>%
filter(n_distinct(HL) == 2) %>%  # ensures both levels exist
ungroup()
# Wilcoxon for Accuracy
acc_htalta <- df_pc_filtered %>%
group_by(block) %>%
wilcox_test(accuracy ~ HL) %>%
adjust_pvalue(method = "bonferroni") %>%
add_significance("p.adj") %>%
select(block, p, p.adj, p.adj.signif)
# Wilcoxon for Reaction Time
rt_htalta <- df_pc_filtered %>%
group_by(block) %>%
wilcox_test(rt ~ HL) %>%
adjust_pvalue(method = "bonferroni") %>%
add_significance("p.adj") %>%
select(block, p, p.adj, p.adj.signif)
# Output as tables
kable(acc_htalta, format = "markdown", digits = 3, caption = "Accuracy: HTA vs LTA (PC only)")
kable(rt_htalta, format = "markdown", digits = 3, caption = "Reaction Time: HTA vs LTA (PC only)")
