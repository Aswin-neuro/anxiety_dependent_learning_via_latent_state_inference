#--- Load and clean data ---#
df <- read.csv('/home/aswin/R/Projects/statistical-test/final_game-data.csv')
df <- df %>%
filter(
!is.na(accuracy),
!is.na(stimulus),
!is.na(HL),
!is.na(pav),
!is.na(block),
!is.na(rt)
) %>%
mutate(
HL = factor(HL),
stimulus = factor(stimulus),
pav = factor(pav),
block = factor(block),
accuracy = as.numeric(accuracy),
rt = as.numeric(rt)
)
length(unique(df$userId))
#
#--- Remove users with inconsistent HL ---#
valid_users <- df %>%
group_by(userId) %>%
filter(n_distinct(HL) == 1) %>%
ungroup() %>%
distinct(userId)
df_clean <- df %>%
semi_join(valid_users, by = "userId")
