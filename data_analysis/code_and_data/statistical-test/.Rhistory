p_value <- mean(abs(boot_vals) >= abs(obs_diff))
#--- Output ---#
cat("Mean Difference (HTA - LTA):", obs_diff, "\n")
cat("95% CI:", CI, "\n")
cat("p-value:", p_value, "\n")
#--- Sanity check ---#
cat("Any NA in bootstrap samples:", anyNA(boot_results$t), "\n")
df_clean <- df %>%
semi_join(valid_users, by = "userId")
length(unique(df_clean$userId))
#--- Mean accuracy per user for one block ---#
df_summary <- df_clean %>%
filter(HL %in% c("HTA", "LTA"), block == '3v1') %>%
group_by(userId, pav) %>%
summarise(
mean_acc = mean(accuracy),
HL = first(HL),
.groups = 'drop'
)
#--- Bootstrap function with NA guard ---#
mean_diff_stat <- function(data, indices) {
d <- data[indices, ]
if (!all(c("HTA", "LTA") %in% d$HL)) return(NA)
mean(d$mean_acc[d$HL == "HTA"]) - mean(d$mean_acc[d$HL == "LTA"])
}
#--- Run bootstrap ---#
set.seed(123)
boot_results <- boot(data = df_summary, statistic = mean_diff_stat, R = 10000)
#--- Confidence interval (manual, due to NA risk) ---#
boot_vals <- boot_results$t[!is.na(boot_results$t)]
obs_diff <- boot_results$t0
CI <- quantile(boot_vals, c(0.025, 0.975))
p_value <- mean(abs(boot_vals) >= abs(obs_diff))
#--- Output ---#
cat("Mean Difference (HTA - LTA):", obs_diff, "\n")
cat("95% CI:", CI, "\n")
cat("p-value:", p_value, "\n")
#--- Sanity check ---#
cat("Any NA in bootstrap samples:", anyNA(boot_results$t), "\n")
