df <- read.csv('/home/aswin/R/Projects/Reinforcement Learning/loseless_game-data.csv')
library(ggplot2)
library(lme4)
library(tidyr)
library(dplyr)
library(emmeans)
library(knitr)
# Data preprocessing - clean, convert to factors, acc to numeric
## cleaning up NA
df <- df %>%
filter(
!is.na(accuracy),
!is.na(stimulus),
!is.na(HL),
!is.na(pav),
!is.na(block)
)
# converting
df$HL <- factor(df$HL)
df$stimulus <- factor(df$stimulus)
df$pav <- factor(df$pav)
df$block <- factor(df$block)
df$accuracy <- as.logical(df$accuracy)
df$rt <- as.numeric(df$rt)
# 1360 rows removed due to the na values
#checking similarity of trial count to check if uniform
table(df$HL, df$pav)
table(df$block)
acc <- df %>%
group_by(HL, pav) %>%
summarise(mean_acc = mean(accuracy), mean_rt = mean(rt),.groups = "drop")
acc
# Multiplication_model - reference
model_multiplication <- glmer(accuracy ~ stimulus * HL * pav * block + (1 | userId),
data = df, family = binomial)
addition <- summary(model_addition)
# Long format
model_stats_long <- model_stats %>%
pivot_longer(cols = c(AIC, BIC), names_to = "Metric", values_to = "Value")
# Extract AIC/BIC values
model_stats <- data.frame(
model = names(models),
AIC = sapply(models, AIC),
BIC = sapply(models, BIC)
)
# list of infos
models <- list(
Full_model = model_addition,
No_Stimulus = model_nostim,
No_HL = model_noHL,
No_pav = model_nopav,
No_block = model_noblock
)
# list of infos
models <- list(
Full_model = model_multiplication,
No_Stimulus = model_nostim,
No_HL = model_noHL,
No_pav = model_nopav,
No_block = model_noblock
)
model_nostim<- glmer(accuracy ~ stimulus + HL * pav * block + (1 | userId),
data = df, family = binomial)
# list of infos
models <- list(
Full_model = model_multiplication,
No_Stimulus = model_nostim,
No_HL = model_noHL,
No_pav = model_nopav,
No_block = model_noblock
)
# Multiplication_model - reference
model_multiplication <- glmer(accuracy ~ stimulus * HL * pav * block + (1 | userId),
data = df, family = binomial)
addition <- summary(model_addition)
# list of infos
models <- list(
Full_model = model_multiplication,
No_Stimulus = model_nostim,
No_HL = model_noHL,
No_pav = model_nopav,
No_block = model_noblock
)
model_noHL<- glmer(accuracy ~ HL + stimulus * pav * block + (1 | userId),
data = df, family = binomial)
model_nostim<- glmer(accuracy ~ stimulus + HL * pav * block + (1 | userId),
data = df, family = binomial)
model_noHL<- glmer(accuracy ~ HL + stimulus * pav * block + (1 | userId),
data = df, family = binomial)
model_nopav<- glmer(accuracy ~ pav + stimulus * HL * block + (1 | userId),
data = df, family = binomial)
model_nopav<- glmer(accuracy ~ pav + stimulus * HL * block + (1 | userId),
data = df, family = binomial)
model_noblock<- glmer(accuracy ~ block +stimulus * HL * pav + (1 | userId),
data = df, family = binomial)
# list of infos
models <- list(
Full_model = model_multiplication,
No_Stimulus = model_nostim,
No_HL = model_noHL,
No_pav = model_nopav,
No_block = model_noblock
)
# Extract AIC/BIC values
model_stats <- data.frame(
model = names(models),
AIC = sapply(models, AIC),
BIC = sapply(models, BIC)
)
# Long format
model_stats_long <- model_stats %>%
pivot_longer(cols = c(AIC, BIC), names_to = "Metric", values_to = "Value")
# AIC & BIC plot
# Option 1: No fixed limits (recommended)
plot <- ggplot(model_stats_long, aes(x = reorder(model, Value), y = Value, fill = Metric)) +
geom_col(position = 'dodge') +
geom_text(aes(label = round(Value, 1)),
position = position_dodge(width = 0.9),
vjust = -0.5, size = 3) +
labs(title = 'Accuracy mult model comparison', x = 'Model', y = 'Value') +
theme_classic()+
coord_cartesian(ylim = c(20500, 22500)) +
scale_fill_manual(values = c('AIC' = 'blue', 'BIC' = 'red'))
plot
ggsave("acc_mult_model_comparison.png", plot = plot, width = 10, height = 6, dpi = 1000)
